{
   "$schema": "../gen/schemas/desktop-schema.json",
   "identifier": "default",
   "description": "Capability for the main window",
   "windows": ["main"],
   "permissions": [
      "core:default",
      "dialog:default",
      "fs:default",
      "fs:allow-read-file",
      "fs:allow-write-file",
      "fs:allow-read-dir",
      "fs:allow-mkdir",
      "fs:allow-remove",
      "fs:allow-rename",
      "fs:allow-exists",
      "fs:allow-copy-file",
      {
         "identifier": "fs:scope",
         "allow": ["$APPDATA/**", "$APPLOCALDATA/**"]
      },
      "opener:default",
      "process:default",
      "updater:default"
   ]
}
