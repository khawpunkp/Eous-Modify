{
   "$schema": "https://schema.tauri.app/config/2",
   "productName": "Eous Modify",
   "version": "0.0.3",
   "identifier": "com.eousmodify.modmanager",
   "build": {
      "beforeDevCommand": "yarn dev",
      "beforeBuildCommand": "yarn build",
      "devUrl": "http://localhost:1420",
      "frontendDist": "../dist"
   },
   "app": {
      "withGlobalTauri": true,
      "security": {
         "csp": null
      },
      "windows": [
         {
            "label": "main",
            "title": "Eous Modify - ZZZ Mod Manager",
            "width": 1400,
            "height": 800,
            "minWidth": 900,
            "minHeight": 650,
            "resizable": true,
            "fullscreen": false,
            "maximized": true,
            "decorations": true,
            "visible": true,
            "center": true
         }
      ]
   },
   "bundle": {
      "active": true,
      "createUpdaterArtifacts": true,
      "icon": [
         "icons/32x32.png",
         "icons/128x128.png",
         "icons/128x128@2x.png",
         "icons/icon.icns",
         "icons/icon.ico"
      ],
      "targets": ["msi"],
      "resources": ["definitions/"],
      "windows": {
         "certificateThumbprint": null,
         "digestAlgorithm": "sha256",
         "timestampUrl": ""
      }
   },
   "plugins": {
      "updater": {
         "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwN0E0QUEyOEMwODAzNUYKUldSZkF3aU1va3A2UUlHWUt2Z2VyVEZlcUp2cDhQWm9pbUMvVHkwQ2VyakNDNjBVejJ4RTl0R0YK",
         "endpoints": [
            "https://github.com/khawpunkp/Eous-Modify/releases/latest/download/latest.json"
         ]
      }
   }
}
